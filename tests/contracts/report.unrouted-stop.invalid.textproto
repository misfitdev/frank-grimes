# A stop for a category that was never routed supplies a probe count the report
# was not asked for, on behalf of a category nobody reviewed.
schema_major: 2
run_id: "run-001"
target { root: "/repo" scope: "src" fingerprint_sha256: "01234567890123456789012345678901" kind: TARGET_KIND_CODE }
mode: MODE_REPORT
iteration: 1
routed_categories: [CATEGORY_SEC]
category_stops { category: CATEGORY_SEC condition: STOP_CONDITION_MARGINAL_YIELD probes_attempted: 0 }
category_stops { category: CATEGORY_COR condition: STOP_CONDITION_MARGINAL_YIELD probes_attempted: 3 }
coverage { examined: "src/a.sh" }
candidates_examined: 1
candidates_disproved: 1
summary: "COR was never routed here."
