# The same claim again at P3. A re-report must not be able to defuse a finding,
# so the ledger keeps the severity it already earned.
schema_major: 2
run_id: "run-001"
target { root: "/repo" scope: "bad-script.sh" fingerprint_sha256: "01234567890123456789012345678901" kind: TARGET_KIND_CODE }
mode: MODE_REPORT
iteration: 3
routed_categories: [CATEGORY_SEC, CATEGORY_COR, CATEGORY_REL, CATEGORY_OPS, CATEGORY_VER]
candidates {
  category: CATEGORY_SEC
  location { anchor { repo_line { path { value: "bad-script.sh" } line: 22 } } }
  risk { severity: SEVERITY_P3 likelihood: LIKELIHOOD_UNLIKELY blast_radius: BLAST_RADIUS_LOCAL_COMPONENT }
  evidence { tier: EVIDENCE_TIER_E2 claim: "caller-controlled deletion path" citation { anchor { repo_line { path { value: "bad-script.sh" } line: 22 } } quote: "rm -rf \"$1\"/*" } }
}
candidates_examined: 5
candidates_disproved: 4
summary: "On another look the deletion path seems cosmetic."
